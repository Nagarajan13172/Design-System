# Static host headers (Netlify / Cloudflare Pages syntax).
#
# Hashed assets are immutable: the filename changes when the content does, so a year
# is safe and a revalidation would be pure waste.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document and the build id must NEVER be cached. index.html is how a
# browser learns which hashed assets exist, and build-id.txt is how an already-open
# tab discovers it is running a previous deploy.
/index.html
  Cache-Control: no-store
/build-id.txt
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
